set quiet := true

# List available recipes
default:
    @just --list

# clippy-fix before fmt: a clippy autofix can land unformatted, so format after
# it, and the `check` that follows (which re-runs fmt-check) stays green.
# Run fixes, then other checks
fix-check: eject clippy-fix fmt check

# Run all checks in parallel (fmt + clippy + tests + unused deps + file size +
# drift). Each arm is `just mmz <subgate>` — mmz wraps it, so a no-op `just
# check` re-run skips every arm whose declared inputs are unchanged, and
# `mmz --is-fresh --tag gate` asserts they all passed without running any.
# Per-rule scopes and the `gate` tag live in .mmz/config.yaml. There is no
# `chronic` here: a cache hit prints mmz's own `on_hit` note to stderr (quiet by
# construction), a miss streams the underlying recipe's stdout/stderr live, and
# a failure propagates its non-zero exit out of `parallel` unchanged.
check:
    parallel -j 0 -- \
        "just mmz fmt-check" \
        "just mmz clippy" \
        "just mmz test" \
        "just mmz machete" \
        "just mmz check-file-size" \
        "just mmz outdatty-check"

# Wrap a just recipe in mmz: `just mmz fmt-check` runs `mmz just fmt-check`. The
# double hop makes mmz the cache identity (rule name `just <recipe>` in
# .mmz/config.yaml), uniform across every sub-gate of `just check`. `just test
# <filter>` (a developer query, no `mmz`) bypasses this recipe and stays plain
# `cargo test` with ARGS — and the `just test` rule is `match: exact`, so even a
# stray `just mmz test <filter>` cannot record the full-suite identity off a
# filtered subset.
mmz *ARGS:
    mmz just {{ ARGS }}

# Fail if a source changed without its dependents being re-confirmed
outdatty-check:
    outdatty check --format quiet

# Re-confirm dependency groups: record current hashes into outdatty.lock
outdatty-update:
    outdatty update

# Run tests only
test *ARGS:
    cargo test --workspace {{ ARGS }}

# Run clippy only
clippy:
    cargo clippy --workspace --all-targets -q -- -D warnings

# Auto-fix clippy warnings (allow-dirty/-staged: fix-check runs pre-commit, tree is dirty).
# Restore write on target/ first: tarpaulin (`just cover`/`just crap`) leaves *.rmeta
# artifacts read-only, and `clippy --fix` then aborts with "output file ... is not
# writeable". Cheap self-heal so `fix-check` after `cover`/`crap` never trips on it.
clippy-fix:
    chmod -R u+w target 2>/dev/null || true
    cargo clippy --fix --workspace --all-targets --allow-dirty --allow-staged -- -D warnings

# Build the project
build *args:
    cargo build --workspace -q {{ args }}

# Run coverage with tarpaulin (also writes target/coverage/lcov.info).
# --all-features so optional-feature code is measured, not silently skipped.
cover:
    cargo tarpaulin --workspace --all-features --skip-clean

# Gate complex, undertested functions via CRAP metric. Needs lcov from `just
# cover` first. Threshold 30 is a sane greenfield default; tune per repo.
# cargo-crap has no --all-features flag: it statically reads source + the lcov
# already produced by `just cover --all-features`, it doesn't build anything.
crap:
    cargo crap --lcov target/coverage/lcov.info --workspace --exclude 'src/main.rs' --threshold 30 --fail-above

# Format code
fmt:
    cargo fmt --all

# Format check (CI-friendly)
fmt-check:
    cargo fmt --all -- --check

# Check for unused dependencies
machete:
    cargo machete

# Count tests across workspace
count-tests:
    #!/usr/bin/env bash
    cargo test --workspace 2>&1 | grep "test result:" | awk '{sum += $4} END {print sum " tests"}'

# Show top 20 files by line count
file-sizes:
    #!/usr/bin/env bash
    find . -type f \( -name '*.rs' -o -name '*.md' \) ! -path './target/*' -exec wc -l {} + | sort -rn | head -20

# Eject inline tests from Rust files nearing the linecop limit, so they stay
# under it without losing the inline-test workflow. Runs as part of `fix-check`.
eject PCT='90':
    linecop --baseline {{ PCT }} --format paths | ejectest apply src --files-from - --lenient

# Check for oversized files (fails if any exceed limits)
check-file-size:
    linecop

# Install git hooks (pre-commit runs `just check`). Running the whole gate on
# every commit is affordable only because each arm is memoized by mmz: a commit
# that touches nothing a gate reads skips every arm, and one that touches a
# single file re-runs only the arms that declare it. The hook checks the
# WORKTREE, not the staged snapshot — the same thing `just check` checks, so a
# green `just check` is a green commit. Hooks are not tracked by git, so run
# this once per clone. Bypass a single commit with `git commit --no-verify`.
install-hooks:
    #!/usr/bin/env bash
    set -eo pipefail
    hook="$(git rev-parse --git-path hooks/pre-commit)"
    mkdir -p "$(dirname "$hook")"
    cat > "$hook" <<'HOOK'
    #!/usr/bin/env bash
    set -eo pipefail
    root="$(git rev-parse --show-toplevel)"
    cd "$root"
    # The gate's tools all come from the flake dev shell; enter it the cheapest
    # way that works here. `direnv exec ... true` is a probe: direnv fails that
    # when .envrc has not been allowed, and the nix develop fallback still runs.
    if command -v mmz >/dev/null 2>&1; then
        exec just check
    elif command -v direnv >/dev/null 2>&1 && direnv exec "$root" true 2>/dev/null; then
        exec direnv exec "$root" just check
    fi
    exec nix develop "$root" --command just check
    HOOK
    chmod +x "$hook"
    echo "installed $hook"

# Tag a release and push (usage: just release 0.1.0)
release VERSION:
    #!/usr/bin/env bash
    set -eo pipefail
    cargo_version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
    if [ "{{ VERSION }}" != "$cargo_version" ]; then
        echo "error: requested v{{ VERSION }} but Cargo.toml is $cargo_version; bump Cargo.toml first" >&2
        exit 1
    fi
    just check
    git tag -a "v{{ VERSION }}" -m "v{{ VERSION }}"
    git push origin "v{{ VERSION }}"
