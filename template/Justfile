set quiet := true

# List available recipes
default:
    @just --list

# clippy-fix before fmt: a clippy autofix can land unformatted, so format after
# it, and the `check` that follows (which re-runs fmt-check) stays green.
# Run fixes, then other checks
fix-check: eject clippy-fix fmt check

# Run all checks in parallel (fmt + clippy + tests + unused deps + file size +
# drift + copy-paste). Each arm is `just mmz <subgate>` — mmz wraps it, so a
# no-op `just check` re-run skips every arm whose declared inputs are unchanged,
# and `mmz --is-fresh --tag gate` asserts they all passed without running any.
# Per-rule scopes and the `gate` tag live in .mmz/config.yaml. There is no
# `chronic` here: a cache hit prints mmz's own `on_hit` note to stderr (quiet by
# construction), a miss streams the underlying recipe's stdout/stderr live, and
# a failure propagates its non-zero exit out of `parallel` unchanged.
check:
    parallel -j 0 -- \
        "just mmz fmt-check" \
        "just mmz clippy" \
        "just mmz test" \
        "just mmz machete" \
        "just mmz check-file-size" \
        "just mmz check-dry" \
        "just mmz outdatty-check"

# Wrap a just recipe in mmz: `just mmz fmt-check` runs `mmz just fmt-check`. The
# double hop makes mmz the cache identity (rule name `just <recipe>` in
# .mmz/config.yaml), uniform across every sub-gate of `just check`. `just test
# <filter>` (a developer query, no `mmz`) bypasses this recipe and stays plain
# `cargo test` with ARGS — and the `just test` rule is `match: exact`, so even a
# stray `just mmz test <filter>` cannot record the full-suite identity off a
# filtered subset.
mmz *ARGS:
    mmz just {{ ARGS }}

# Fail if a source changed without its dependents being re-confirmed
outdatty-check:
    outdatty check --format quiet

# Re-confirm dependency groups: record current hashes into outdatty.lock
outdatty-update:
    outdatty update

# Run tests only
test *ARGS:
    cargo test --workspace {{ ARGS }}

# Run clippy only
clippy:
    cargo clippy --workspace --all-targets -q -- -D warnings

# Auto-fix clippy warnings (allow-dirty/-staged: fix-check runs pre-commit, tree is dirty).
clippy-fix:
    cargo clippy --fix --workspace --all-targets --allow-dirty --allow-staged -- -D warnings

# Build the project
build *args:
    cargo build --workspace -q {{ args }}

# Run coverage with cargo-llvm-cov. llvm-cov, unlike tarpaulin, merges the
# profraw of child processes, so subprocess-based CLI e2e tests actually
# attribute to the code they exercise. Instrument once (--no-report), then
# render both reports from that profdata. main.rs is excluded — keep it thin;
# `just crap` excludes it too. The /registry/src/ ignore keeps local and CI
# reporting the same set when CARGO_HOME is relocated.
cover:
    #!/usr/bin/env bash
    set -eo pipefail
    ignore='src/main\.rs|/registry/src/'
    mkdir -p target/coverage
    cargo llvm-cov --workspace --no-report
    cargo llvm-cov report --ignore-filename-regex "$ignore" \
        --lcov --output-path target/coverage/lcov.info
    cargo llvm-cov report --ignore-filename-regex "$ignore" --fail-under-lines 70

# Gate complex, undertested functions via CRAP metric. Needs lcov from `just
# cover` first. Threshold 30 is a sane greenfield default; tune per repo.
# `--exclude main.rs` is harmless for libs (where the file doesn't exist).
crap:
    cargo crap --lcov target/coverage/lcov.info --workspace --exclude 'src/main.rs' --threshold 30 --fail-above

# Format code
fmt:
    cargo fmt --all

# Format check (CI-friendly)
fmt-check:
    cargo fmt --all -- --check

# Check for unused dependencies
machete:
    cargo machete

# Count tests across workspace
count-tests:
    #!/usr/bin/env bash
    cargo test --workspace 2>&1 | grep "test result:" | awk '{sum += $4} END {print sum " tests"}'

# Show top 20 files by line count
file-sizes:
    #!/usr/bin/env bash
    find . -type f \( -name '*.rs' -o -name '*.md' \) ! -path './target/*' -exec wc -l {} + | sort -rn | head -20

# Eject inline tests from Rust files nearing the linecop limit, so they stay
# under it without losing the inline-test workflow. Runs as part of `fix-check`.
eject PCT='90':
    linecop --baseline {{ PCT }} --format paths | ejectest apply src --files-from - --lenient

# Check for oversized files (fails if any exceed limits)
check-file-size:
    linecop

# Copy-paste gate: fail on any duplicated Rust block across the crate.
check-dry:
    #!/usr/bin/env bash
    set -eo pipefail
    # jscpd (the Rust port, packaged via qahq in flake.nix) fails on any
    # duplicated block of >=70 tokens, naming both spans. Fix a finding by
    # extracting a shared helper — never by shuffling tokens until the
    # detector loses the scent.
    #
    # `--exit-code 1` is spelled with its value: bare `--exit-code` would
    # swallow the following path argument as its optional code.
    jscpd --no-tips -k 70 -f rust --exit-code 1 src tests

# Install git hooks. Copies scripts/pre-commit to .git/hooks/pre-commit.
# The hook runs `mmz --is-fresh --tag gate` — a freshness assertion, not
# a re-run of the gate, so it is cheap enough for every commit. Hooks are
# not tracked by git, so run this once per clone. Bypass a single commit
# with `git commit --no-verify`.
install-hooks:
    #!/usr/bin/env bash
    set -eo pipefail
    hook="$(git rev-parse --git-path hooks/pre-commit)"
    mkdir -p "$(dirname "$hook")"
    cp scripts/pre-commit "$hook"
    chmod +x "$hook"
    echo "installed $hook"

# Tag a release and push (usage: just release 0.1.0)
release VERSION:
    #!/usr/bin/env bash
    set -eo pipefail
    cargo_version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
    if [ "{{ VERSION }}" != "$cargo_version" ]; then
        echo "error: requested v{{ VERSION }} but Cargo.toml is $cargo_version; bump Cargo.toml first" >&2
        exit 1
    fi
    mmz --is-fresh --tag gate
    git tag -a "v{{ VERSION }}" -m "v{{ VERSION }}"
    git push origin "v{{ VERSION }}"

# Pre-PR mutation check — the daily driver. Sweeps only mutants touched by
# this branch's diff against main, so it needs no state file and covers new
# files for free (every line of a new file is "touched"). A surviving MISSED
# mutant is a real assertion gap: a line covered but not pinned.
mutants-diff *ARGS:
    #!/usr/bin/env bash
    set -eo pipefail
    export CARGO_MUTANTS_JOBS="${CARGO_MUTANTS_JOBS:-3}"
    diff_file=$(mktemp)
    trap 'rm -f "$diff_file"' EXIT
    git diff "$(git merge-base main HEAD)" > "$diff_file"
    cargo mutants --in-diff "$diff_file" {{ ARGS }}

# Full-file mutation sweep — a dev aid, never a gate. Extra args pass through
# to cargo-mutants. File set and excludes come from .cargo/mutants.toml.
mutants *ARGS:
    cargo mutants {{ ARGS }}
