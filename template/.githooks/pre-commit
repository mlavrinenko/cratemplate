#!/usr/bin/env bash
set -eo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

# `mmz --is-fresh --tag gate` asserts every gate-tagged rule in
# .mmz/config.yaml already passed against this worktree, running
# nothing of its own. It is cheap enough for every commit.
# Enter the flake dev shell the cheapest way available.
if command -v mmz >/dev/null 2>&1; then
  exec mmz --is-fresh --tag gate
elif command -v direnv >/dev/null 2>&1 && direnv exec "$root" true 2>/dev/null; then
  exec direnv exec "$root" mmz --is-fresh --tag gate
fi
exec nix develop "$root" --command mmz --is-fresh --tag gate
